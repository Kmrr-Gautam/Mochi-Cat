{
  "name": "mochi-cat",
  "version": "1.0.0",
  "description": "An ultra-cute, living Windows desktop cat companion",
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "webpack --mode production",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "dev": "webpack --mode development && tsc -p tsconfig.main.json && electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "jest"
  },
  "keywords": [
    "desktop-pet",
    "mochi",
    "cat",
    "virtual-pet",
    "electron",
    "pixijs"
  ],
  "author": "Mochi Team",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-store": "^8.2.0",
    "pixi.js": "^7.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "html-webpack-plugin": "^5.6.8",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3"
  },
  "build": {
    "appId": "com.mochi.cat",
    "productName": "Mochi Cat",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
